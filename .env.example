# Copy to .env for local dev: cp .env.example .env

# OpenAI key: a Restricted project key with "Model capabilities: Write"
OPEN_AI_KEY=

# Optional model override (default gpt-6-luna). Must accept reasoning_effort "none".
# OPENAI_MODEL=

# Return canned mnemonics without calling OpenAI (no spend). Leave unset in prod.
MOCK_AI=true
