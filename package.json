{
  "name": "you-need-a-passphrase",
  "description": "An app for generating a long passphrase",
  "author": "Christian Danielsen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "client:build": "tsc && vite build",
    "netlify": "netlify",
    "dev": "netlify dev",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier . --write --ignore-unknown",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:functions": "esbuild netlify/functions/mnemonic/index.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fn-check/index.mjs --log-level=warning",
    "ci": "npm run lint && npm run typecheck && npm test && npm run client:build && npm run check:functions"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/alfa-slab-one": "^5.0.12",
    "@netlify/functions": "^2.0.2",
    "framer-motion": "^10.16.4",
    "openai": "^4.104.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-icons": "^4.11.0",
    "react-router-dom": "^6.16.0",
    "typewriter-effect": "^2.20.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-router": "^5.1.20",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "netlify-cli": "^16.3.2",
    "prettier": "^3.0.2",
    "typescript": "~5.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
